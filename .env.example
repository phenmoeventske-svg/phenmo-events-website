# ==============================================================================
# PHENMO EVENTS — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Rename this file to .env and fill in your Supabase credentials.
# You can find these in your Supabase Dashboard: Settings -> API
# ==============================================================================

# Supabase Project URL (e.g., https://abcdefghijkl.supabase.co)
SUPABASE_URL=

# Supabase Anon Public Key (used by client applications & portal)
SUPABASE_ANON_KEY=

# Supabase Service Role Secret Key (used by backend server for admin & sync)
SUPABASE_SERVICE_ROLE_KEY=

# Optional custom server port (defaults to 8000)
PORT=8000

# Master Portal Security Gate Password (All-round code required before selecting an account)
PORTAL_MASTER_KEY=phenmo2026
